# Public API base URL. Never put secrets in VITE_* variables.
#
# Figma Make / standalone preview:
VITE_API_BASE_URL=https://delivery-management-backend-fqen.onrender.com/api/v1
#
# Local Spring Boot (create an untracked .env.local with this value):
# VITE_API_BASE_URL=http://localhost:8080/api/v1
#
# Combined Docker stack (provided by delivery-management/docker-compose.yml):
# VITE_API_BASE_URL=/api/v1

# Optional: enables the in-app Google route map (driver marker + route polyline).
# Restrict this browser key to your Vercel domains in Google Cloud and enable
# Maps JavaScript API + Directions API. Do not use a server-secret key here.
# VITE_GOOGLE_MAPS_API_KEY=
#
# Administrative API: V1 is intentionally used by the current three-level UI.
# V1 is the provider's legacy pre-07/2025 dataset; replace this endpoint when
# migrating the project to an updated three-level administrative source.
# VITE_PROVINCES_API_BASE_URL=https://provinces.open-api.vn/api/v1
